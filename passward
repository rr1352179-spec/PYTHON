s = input("Enter the password: ")

up = 0
sm = 0
dg = 0
sp = 0

if len(s) >= 8:
    for i in s:
        if i.isupper():
            up += 1
        elif i.islower():
            sm += 1
        elif i.isdigit():
            dg += 1
        else:
            sp += 1

    if dg > 0 and sp > 0 and up > 0 and sm > 0:
        print("IT IS STRONG")
    else:
        print("IT IS WEAK")
else:
    print("IT IS WEAK DUE TO LESS LENGTH")
